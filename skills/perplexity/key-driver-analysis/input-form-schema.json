{
  "submit_label": "Run analysis",
  "query_template": "Run an institutional investor key driver analysis on {{ticker}}. Time horizon: {{time_horizon}}. Focus areas: {{focus_areas}}. Preferred data source: {{data_source}}. Output format: {{output_format}}. {{additional_context}}",
  "pages": [
    {
      "title": "What stock do you want to analyze?",
      "description": "Identify what actually makes a stock go up and down",
      "fields": [
        {
          "key": "ticker",
          "type": "text",
          "label": "Stock ticker",
          "required": true,
          "placeholder": "e.g., AMZN, NVDA, TSLA"
        },
        {
          "key": "time_horizon",
          "type": "select",
          "label": "Analysis time horizon",
          "required": true,
          "default": "5 years",
          "options": [
            {
              "value": "3 years",
              "label": "3 years"
            },
            {
              "value": "5 years",
              "label": "5 years"
            },
            {
              "value": "10 years",
              "label": "10 years"
            }
          ]
        },
        {
          "key": "focus_areas",
          "type": "multi_select",
          "label": "Driver categories to analyze",
          "required": false,
          "options": [
            {
              "value": "Fundamentals (revenue, margins, EPS)",
              "label": "Fundamentals (revenue, margins, EPS)",
              "icon": "trending-up"
            },
            {
              "value": "Business segments & KPIs",
              "label": "Business segments & KPIs",
              "icon": "chart-line"
            },
            {
              "value": "Management guidance vs actuals",
              "label": "Management guidance vs actuals",
              "icon": "clipboard-list"
            },
            {
              "value": "Estimate revisions",
              "label": "Estimate revisions",
              "icon": "trending-up"
            },
            {
              "value": "Multiple expansion/compression",
              "label": "Multiple expansion/compression",
              "icon": "calculator"
            },
            {
              "value": "Macro & rates sensitivity",
              "label": "Macro & rates sensitivity",
              "icon": "world"
            },
            {
              "value": "Peer stock correlation",
              "label": "Peer stock correlation",
              "icon": "users"
            },
            {
              "value": "Earnings surprise reactions",
              "label": "Earnings surprise reactions",
              "icon": "sparkles"
            }
          ]
        },
        {
          "key": "additional_context",
          "type": "textarea",
          "label": "Additional context",
          "required": false,
          "collapsible_group": "Additional settings",
          "placeholder": "e.g., I think AWS is the key driver \u2014 validate this. Or: focus on estimate revisions and margin expansion since 2022."
        },
        {
          "key": "data_source",
          "type": "select",
          "label": "Preferred data source",
          "required": true,
          "description": "Select the authoritative source for figures and data pulls.",
          "default": "Perplexity Finance",
          "options": [
            {
              "value": "Perplexity Finance",
              "label": "Perplexity Finance"
            },
            {
              "value": "FactSet",
              "label": "FactSet"
            },
            {
              "value": "Daloopa",
              "label": "Daloopa"
            },
            {
              "value": "Morningstar",
              "label": "Morningstar"
            },
            {
              "value": "PitchBook",
              "label": "PitchBook"
            }
          ]
        },
        {
          "key": "output_format",
          "type": "select",
          "label": "Output format",
          "required": true,
          "default": "XLSX",
          "options": [
            {
              "value": "XLSX",
              "label": "XLSX"
            },
            {
              "value": "PDF",
              "label": "PDF"
            },
            {
              "value": "PDF (Presentation)",
              "label": "PDF (Presentation)"
            },
            {
              "value": "Dashboard",
              "label": "Dashboard"
            }
          ]
        }
      ]
    }
  ]
}